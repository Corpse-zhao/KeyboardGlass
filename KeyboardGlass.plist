<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<!--
			只注入系统键盘所在的宿主 App 进程与 SpringBoard。

			v0.3.0 起**彻底移除第三方输入法** (微信输入法等)：
			用户反馈「打不了字」在微信输入法上同样复现，而第三方输入法是独立的
			Keyboard Extension 进程、视图全部自绘，我们对系统键盘写的那套
			锚点/层级假设在那里完全不成立 —— 在别人的键盘进程里插层是纯粹的赌博。
			用户自己的要求也是「先做原生键盘，再做微信输入法」。
			要做第三方输入法时, 必须单独立一个开关, 且默认关闭。
		-->
		<key>Bundles</key>
		<array>
			<string>com.apple.UIKit</string>
			<string>com.apple.springboard</string>
		</array>
	</dict>
</dict>
</plist>
